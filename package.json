{
  "name": "qc_app_qa",
  "version": "1.0.0",
  "description": "Appium-based E2E testing for Quantum Connect Flutter mobile app",
  "main": "index.js",
  "scripts": {
    "test": "wdio run src/config/wdio.conf.ts",
    "test:android": "wdio run src/config/wdio.android.conf.ts",
    "test:ios": "wdio run src/config/wdio.ios.conf.ts",
    "test:auth": "wdio run src/config/wdio.android.conf.ts --spec ./src/tests/specs/auth/login.spec.ts",
    "test:connection": "wdio run src/config/wdio.android.conf.ts --spec src/tests/specs/connection/**/*.ts",
    "test:mapping": "wdio run src/config/wdio.android.conf.ts --spec src/tests/specs/mapping/**/*.ts",
    "test:smoke": "wdio run src/config/wdio.android.conf.ts --spec src/tests/specs/smoke/**/*.ts",
    "report:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:open": "allure open reports/allure-report",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^8.40.0",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^8.40.0",
    "@wdio/local-runner": "^8.40.0",
    "@wdio/mocha-framework": "^8.40.0",
    "@wdio/spec-reporter": "^8.40.0",
    "allure-commandline": "^2.29.0",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^4.0.0",
    "appium-xcuitest-driver": "^12.0.0",
    "dotenv": "^16.4.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "mobile",
    "testing",
    "automation"
  ],
  "author": "",
  "license": "ISC"
}
